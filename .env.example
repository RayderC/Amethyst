# Required: secret used to sign the iron-session cookie. Must be 32+ characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Optional: override the SQLite database location inside the container.
# Defaults to /data/amethyst.db in the Docker image.
# DATABASE_PATH=/data/amethyst.db

# Optional: set to "false" if you're serving over plain HTTP (e.g. local LAN
# access without a TLS-terminating reverse proxy). Defaults to true in
# production, which prevents the session cookie from being sent over HTTP.
# SESSION_COOKIE_SECURE=true
